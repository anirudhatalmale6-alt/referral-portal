# Copy this file to .env and fill it in on the server.
NODE_ENV=production
PORT=3000

# Long random string. Signs the login cookies — changing it signs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Where the database file lives. Keep it on a backed-up, encrypted disk.
DATA_DIR=/var/lib/referral-portal

# Only used the very first time the app starts, to create the first admin login.
ADMIN_USER=admin
ADMIN_PASS=
